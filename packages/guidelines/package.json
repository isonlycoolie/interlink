{
  "name": "@interlink/guidelines",
  "version": "0.0.0",
  "private": true,
  "description": "Interlink usage guidelines as data, each with live Do and Don't examples built from Interlink components.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/generated/registry.ts",
    "./kit": "./src/kit/index.ts",
    "./kit.css": "./src/kit/kit.css"
  },
  "scripts": {
    "build": "node scripts/build-sources.mjs",
    "test": "node scripts/build-sources.mjs && vitest run",
    "typecheck": "node scripts/build-sources.mjs && tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@interlink/icons": "workspace:*",
    "@interlink/react": "workspace:*",
    "@interlink/tokens": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
